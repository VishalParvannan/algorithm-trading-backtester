# Document hosting environment variables without including real credentials.
QUANTLAB_AUTH_MODE=accounts
# Case-sensitive invitation code for new accounts, locally and hosted.
# Individual users choose their own passwords on the sign-up page.
QUANTLAB_INVITATION_CODE=quantbacktestlab
# Only needed with QUANTLAB_AUTH_MODE=legacy (at least 16 characters hosted).
QUANTLAB_PASSWORD=
QUANTLAB_PUBLIC=1
QUANTLAB_DB_PATH=/app/data/quantlab.sqlite
ALPHA_VANTAGE_API_KEY=
